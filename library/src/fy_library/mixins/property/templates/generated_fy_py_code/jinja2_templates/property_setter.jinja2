class {{ python_class_name.pascal_case }}(
    {% for abstract_property_mixin in  abstract_property_mixins -%}
    {{ abstract_property_mixin.python_class_name.pascal_case }},
    {%- endfor %}
{% if generics_def %}
    Generic[{{ generics_def }}]
{% endif -%}):
    @property
    def _{{ property_name.snake_case }}(self) -> {{ property_type }}:
        return self.__{{ property_name.snake_case }}

    @_{{ property_name.snake_case }}.setter
    def _{{ property_name.snake_case }}(self, {{ property_name.snake_case }}: {{ property_type }}) -> None:
        self.__{{ property_name.snake_case }} = {{ property_name.snake_case }}

