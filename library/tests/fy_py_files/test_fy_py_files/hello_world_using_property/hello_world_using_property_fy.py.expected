"""fy
flow HelloWorld -> None:
    property greeting using constant("Hello")
fy"""

from fy_core.base.flow_base import FlowBase
from fy_py_files.test_fy_py_files.hello_world_using_property.property.using_constant_greeting import (
    Greeting_UsingSetter_PropertyMixin,
)
from typing import Any


# fy:start ===>>>
class HelloWorld_Flow(
    # Property Mixins
    Greeting_UsingSetter_PropertyMixin,
    # Base
    FlowBase[None],
):
    def __init__(
        self,
        *args: Any,
        **kwargs: Any,
    ):
        self._greeting = "Hello"
        super().__init__(*args, **kwargs)

    def __call__(self) -> None:
        # fy:end <<<===
        print(self._greeting)
